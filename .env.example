# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Firebase console
# (Project settings → General → Your apps → Web app → SDK setup and configuration → Config)
# .env.local ไม่ถูก commit ขึ้น Git (อยู่ใน .gitignore แล้วผ่านกฎ *.local)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=bannbrew-a9bc4.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bannbrew-a9bc4
VITE_FIREBASE_STORAGE_BUCKET=bannbrew-a9bc4.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Lab 4 · npm run analytics ใช้ service account key (Firebase console → Project settings → Service accounts → Generate new private key)
# เก็บไฟล์ไว้ในโฟลเดอร์ secrets/ เท่านั้น (อยู่ใน .gitignore แล้ว)
FIREBASE_SERVICE_ACCOUNT=secrets/service-account.json
