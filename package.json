{
  "name": "baanbrew-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "screenshots": "node scripts/screenshots.mjs",
    "import:firestore": "node scripts/import-firestore.mjs",
    "deploy": "npm run build && npx firebase-tools deploy --only hosting,firestore:rules",
    "test": "vitest run",
    "analytics:dry": "node scripts/build-analytics.mjs --dry-run",
    "analytics": "node --env-file-if-exists=.env.local scripts/build-analytics.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^13.0.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-admin": "^13.10.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  }
}
